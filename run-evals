#!/usr/bin/env python3
"""Run Pixie's design-skill evals against a local Pixie checkout and print pass/fail per task and per grader.

  ./run-evals --pixie ../pixie                        run every case
  ./run-evals --pixie ../pixie --case setup-react     run some cases
  ./run-evals --pixie ../pixie --grade-only results/iteration-3   grade an earlier run again
  ./run-evals --pixie ../pixie --against ../pixie-old --runs 3   compare two Pixie checkouts
"""
import argparse
import sys
from pathlib import Path

from evalkit.cases import load_cases
from evalkit.comparison import write_and_report
from evalkit.runner import (check_pixie, next_iteration, regrade, regrade_comparison, report, run_case,
                            run_comparison, write_metadata)

ROOT = Path(__file__).resolve().parent


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--pixie", required=True, type=Path, help="path to a local Pixie checkout")
    p.add_argument("--case", action="append", help="run only this case (repeatable)")
    p.add_argument("--grade-only", type=Path, metavar="ITERATION", help="grade an earlier iteration's repos again")
    p.add_argument("--against", type=Path, metavar="OLD",
                   help="compare --pixie (new_skill) with this Pixie checkout (old_skill)")
    p.add_argument("--runs", type=int, default=1, help="in a comparison, runs of each case per checkout (default 1)")
    p.add_argument("--judge-model", default="opus", help="in a comparison, the judge's model (default opus)")
    a = p.parse_args()
    if a.runs < 1:
        p.error("--runs must be at least 1")
    pixie = a.pixie.resolve()
    check_pixie(pixie)
    cases = load_cases(ROOT / "evals", a.case)

    if a.grade_only:
        iteration = a.grade_only.resolve()
        if any(iteration.glob("*/new_skill")):
            regrade_comparison(iteration, cases)
            sys.exit(0 if write_and_report(iteration, cases) else 1)
        sys.exit(0 if report(regrade(iteration, cases, pixie)) else 1)

    against = a.against.resolve() if a.against else None
    if against:
        check_pixie(against)
    iteration = next_iteration(ROOT / "results")
    print(f"Results: {iteration}")
    rows = []
    for index, case in enumerate(cases, 1):
        print(f"Running {case.name}...", flush=True)
        if against:
            run_comparison(case, index, iteration, {"new_skill": pixie, "old_skill": against}, a.runs,
                           ROOT / "fixtures", a.judge_model)
        else:
            write_metadata(case, index, iteration / case.name)
            results, error = run_case(case, iteration / case.name / "with_skill", pixie, ROOT / "fixtures")
            rows.append((case, results, error))
    ok = write_and_report(iteration, cases) if against else report(rows)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
